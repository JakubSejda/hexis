# Copy to .env.production on the server and fill in. NEVER commit the real file.

# Domain Caddy serves (A record must point at the VPS before first start —
# Let's Encrypt validates over HTTP).
DOMAIN=hexis.example.com

# MySQL root password — generate: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# App → MySQL over the compose network (host is the service name `mysql`).
# Password must match MYSQL_ROOT_PASSWORD above.
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/hexis

# NextAuth — generate secret: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=https://hexis.example.com

# Photo uploads path inside the app container (backed by the `uploads` volume).
STORAGE_ROOT=/data/uploads

# Sentry (D2) — leave empty to disable error tracking entirely.
SENTRY_DSN=
